# Port the combined Next.js + Socket.IO server listens on.
PORT=3000

# Comma-separated origins allowed to open WebSocket connections (CSRF / CSWSH defence).
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL. Leave empty to run in memory-only demo mode (rooms lost on restart).
DATABASE_URL=postgresql://avalon:avalon@localhost:5432/avalon?schema=public

# 32-byte hex key used to encrypt game snapshots at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SNAPSHOT_ENCRYPTION_KEY=

# debug | info | warn | error
LOG_LEVEL=info
